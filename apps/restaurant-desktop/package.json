{
  "name": "@uzbite/restaurant-desktop",
  "version": "1.0.0",
  "description": "UzBite Restaurant Desktop application for Windows",
  "author": "UzBite",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --port 8083 --strictPort",
    "desktop": "npm run build:electron && node electron/launch.mjs",
    "build:electron": "tsc -p tsconfig.electron.json && tsc -p tsconfig.preload.json && node -e \"import('node:fs').then(fs=>fs.renameSync('dist-electron/preload.js','dist-electron/preload.cjs'))\"",
    "build:renderer": "tsc -p tsconfig.json --noEmit && vite build",
    "build": "npm run build:electron && npm run build:renderer",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.preload.json --noEmit",
    "preview": "vite preview --port 8083 --strictPort",
    "dist": "npm run build && electron-builder --win --x64"
  },
  "build": {
    "appId": "uz.uzbite.restaurant.desktop",
    "productName": "UzBite Restaurant",
    "npmRebuild": false,
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "build/icon.png",
      "build/icon.ico",
      "package.json",
      "!**/node_modules/**",
      "!**/*.tsbuildinfo"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        },
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "UzBite-Restaurant-${version}-portable.exe"
    },
    "nsis": {
      "artifactName": "UzBite-Restaurant-${version}-setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
