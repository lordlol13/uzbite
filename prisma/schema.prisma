generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  RESTAURANT
}

enum OrderStatus {
  PENDING_ACCEPTANCE
  ACCEPTED
  PREPARING
  DELIVERING
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH
  CARD
}

enum PaymentStatus {
  AWAITING_PAYMENT
  AWAITING_CONFIRMATION
  PAID
  REJECTED
}

enum UploadPurpose {
  AVATAR
  RECEIPT
}

enum ExpenseCategory {
  INGREDIENTS
  PACKAGING
  SALARY
  RENT
  UTILITIES
  COMMUNICATION
  MARKETING
  DELIVERY
  EQUIPMENT
  TAXES
  OTHER
}

model User {
  id                String         @id @default(cuid())
  email             String?        @unique
  passwordHash      String
  name              String
  username          String         @unique
  usernameChangedAt DateTime?
  bio               String         @default("")
  avatarUrl         String?
  recipientName     String?
  deliveryAddressId String?
  deliveryAddress   UserAddress?   @relation("DeliverySelection", fields: [deliveryAddressId], references: [id], onDelete: SetNull)
  phone             String?
  role              Role           @default(USER)
  tokenVersion      Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  settings          UserSettings?
  addresses         UserAddress[]
  reviews           Review[]
  orders            Order[]
  uploads           Upload[]
  sessions          Session[]
  managedRestaurant Restaurant?    @relation("RestaurantOwner")

  @@index([deliveryAddressId])
}

model Session {
  id          String   @id @default(cuid())
  userId      String
  refreshHash String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model UserSettings {
  userId   String @id
  language String @default("ru")
  theme    String @default("light")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserAddress {
  id          String   @id @default(cuid())
  userId      String
  latitude    Float
  longitude   Float
  addressText String
  label       String   @default("Дом")
  entrance    String   @default("")
  floor       String   @default("")
  apartment   String   @default("")
  comment     String   @default("")
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  selectedBy  User[]   @relation("DeliverySelection")

  @@index([userId])
}

model Restaurant {
  id                  String               @id @default(cuid())
  slug                String               @unique
  name                String
  description         String
  logoUrl             String
  coverUrl            String
  addressText         String
  landmark            String               @default("")
  latitude            Float
  longitude           Float
  phone               String?
  telegram            String?
  isOpen              Boolean              @default(true)
  acceptingOrders     Boolean              @default(true)
  timezone            String               @default("Asia/Tashkent")
  onboardingCompleted Boolean              @default(false)
  preparationMinutes  Int                  @default(20)
  deliveryFee         Decimal              @default(10000) @db.Decimal(14, 2)
  minOrder            Decimal              @default(20000) @db.Decimal(14, 2)
  acceptCash          Boolean              @default(true)
  acceptCard          Boolean              @default(false)
  paymentRecipient    String?
  paymentDetails      String?
  paymentQrUrl        String?
  paymentInstructions String?
  ownerId             String?              @unique
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  owner               User?                @relation("RestaurantOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  categories          RestaurantCategory[]
  dishes              Dish[]
  reviews             Review[]
  orders              Order[]
  suppliers           Supplier[]
  expenses            Expense[]
  budgets             ExpenseBudget[]

  @@index([name])
}

model RestaurantCategory {
  id           String     @id @default(cuid())
  restaurantId String
  name         String
  sortOrder    Int        @default(0)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  dishes       Dish[]

  @@unique([restaurantId, name])
}

model Dish {
  id           String             @id @default(cuid())
  restaurantId String
  categoryId   String
  sku          String?
  name         String
  description  String
  price        Decimal            @db.Decimal(14, 2)
  costPrice    Decimal            @default(0) @db.Decimal(14, 2)
  imageUrl     String
  isAvailable  Boolean            @default(true)
  isArchived   Boolean            @default(false)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  restaurant   Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category     RestaurantCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems   OrderItem[]

  @@unique([restaurantId, sku])
  @@index([restaurantId, isAvailable])
  @@index([name])
}

model Review {
  id           String     @id @default(cuid())
  orderId      String     @unique
  userId       String
  restaurantId String
  rating       Int
  text         String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  order        Order      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user         User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Restrict)

  @@index([restaurantId, createdAt])
}

model Order {
  id                String      @id @default(cuid())
  userId            String
  restaurantId      String
  restaurantName    String
  restaurantAddress String
  addressSnapshot   Json
  recipientName     String
  recipientPhone    String
  subtotal          Decimal     @db.Decimal(14, 2)
  deliveryFee       Decimal     @db.Decimal(14, 2)
  total             Decimal     @db.Decimal(14, 2)
  status            OrderStatus @default(PENDING_ACCEPTANCE)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  user              User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  restaurant        Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  items             OrderItem[]
  payment           Payment?
  review            Review?

  @@index([userId, createdAt])
  @@index([restaurantId, status])
  @@index([restaurantId, createdAt])
  @@index([restaurantId, status, createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  dishId    String?
  dishName  String
  unitPrice Decimal @db.Decimal(14, 2)
  quantity  Int
  imageUrl  String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  dish      Dish?   @relation(fields: [dishId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String        @unique
  method          PaymentMethod
  status          PaymentStatus @default(AWAITING_PAYMENT)
  receiptId       String?       @unique
  rejectionReason String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  receipt         Upload?       @relation(fields: [receiptId], references: [id], onDelete: Restrict)
}

model Upload {
  id        String        @id @default(cuid())
  userId    String
  key       String        @unique
  mimeType  String
  size      Int
  purpose   UploadPurpose
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  payment   Payment?
  expense   Expense?

  @@index([userId, purpose])
}

model Supplier {
  id           String          @id @default(cuid())
  restaurantId String
  name         String
  taxId        String?
  phone        String?
  category     ExpenseCategory @default(INGREDIENTS)
  createdAt    DateTime        @default(now())
  restaurant   Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  expenses     Expense[]

  @@unique([restaurantId, name])
}

model Expense {
  id            String          @id @default(cuid())
  restaurantId  String
  supplierId    String?
  category      ExpenseCategory
  itemName      String          @default("")
  description   String
  amount        Decimal         @db.Decimal(14, 2)
  quantity      Decimal?        @db.Decimal(14, 3)
  unit          String?
  unitPrice     Decimal?        @db.Decimal(14, 2)
  invoiceNumber String?
  spentAt       DateTime
  receiptId     String?         @unique
  source        String          @default("MANUAL")
  isVerified    Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  restaurant    Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  supplier      Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  receipt       Upload?         @relation(fields: [receiptId], references: [id], onDelete: SetNull)

  @@index([restaurantId, spentAt])
  @@index([restaurantId, category, spentAt])
  @@index([restaurantId, invoiceNumber])
}

model ExpenseBudget {
  id           String          @id @default(cuid())
  restaurantId String
  category     ExpenseCategory
  month        DateTime
  limit        Decimal         @db.Decimal(14, 2)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  restaurant   Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, category, month])
}
