# Copy to .env at the workspace root. setup:local generates local secrets instead.
NODE_ENV=development
HOST=0.0.0.0
PORT=8081
DATABASE_URL=postgresql://uzbite:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/uzbite?schema=public
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_PASSWORD
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:4173,http://127.0.0.1:4173,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:8080,http://127.0.0.1:8080,http://localhost:8082,http://127.0.0.1:8082,http://localhost:8083,http://127.0.0.1:8083,http://localhost:19006,capacitor://localhost

# Desktop client target URL (local loopback or LAN IP e.g. http://192.168.1.100:8081 or production HTTPS URL)
UZBITE_API_BASE_URL=http://127.0.0.1:8081

# Optional AI advisor (Gemini). When empty, deterministic AI heuristics run locally.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Coarena Free Model API (gemini-3-8-flash, deepseek-v4-1-flash-1017, gpt-6-luna)
COARENA_API_KEY=
COARENA_BASE_URL=https://coarena.ai/api/v1
COARENA_MODEL=gemini-3-8-flash

# Approximate delivery time: preparation + pickup + distance-based travel.
DELIVERY_AVERAGE_SPEED_KMH=18
DELIVERY_ROAD_FACTOR=1.35
DELIVERY_PICKUP_MINUTES=5
DELIVERY_ESTIMATE_MARGIN_MINUTES=10

# Optional S3-compatible provider. Receipts are private objects; avatars use CDN.
# Leave blank until a real bucket and credentials are configured.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_PRIVATE_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CDN_BASE_URL=

# Development seeding is disabled when NODE_ENV=production.
ALLOW_DEVELOPMENT_SEED=false
